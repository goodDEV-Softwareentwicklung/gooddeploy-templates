# Vorlage für .env.development.local (lokal, nie committen).
# Auf gooddeploy setzt du Werte mit `gooddeploy env add <NAME>`;
# DATABASE_URL und DATABASE_URL_UNPOOLED setzt gooddeploy selbst.

# Lokale Datenbank (README: „Lokal starten“)
DATABASE_URL="postgres://postgres:postgres@localhost:5432/starter"
DATABASE_URL_UNPOOLED="postgres://postgres:postgres@localhost:5432/starter"

# Pflicht: mindestens 32 zufällige Zeichen, z. B. `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# Optional: eigene Domains der App (Komma-Liste), z. B. app.example.de
BETTER_AUTH_ALLOWED_HOSTS=

# Optional: E-Mail-Versand (Bestätigung, Passwort-Reset). Ohne SMTP_HOST,
# SMTP_PORT und SMTP_FROM ist er aus, die App läuft trotzdem.
SMTP_HOST=
SMTP_PORT=
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=
