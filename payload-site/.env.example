# Vorlage für .env.development.local (lokal, nie committen).
# Auf gooddeploy setzt du Werte mit `gooddeploy env add <NAME>`;
# DATABASE_URL und DATABASE_URL_UNPOOLED setzt gooddeploy selbst.

# Lokale Datenbank (README: „Lokal starten“)
DATABASE_URL="postgres://postgres:postgres@localhost:5432/site"
DATABASE_URL_UNPOOLED="postgres://postgres:postgres@localhost:5432/site"

# Auf gooddeploy Pflicht (setzt gooddeploy init), lokal optional:
# mindestens 32 zufällige Zeichen, z. B. `openssl rand -base64 32`
PAYLOAD_SECRET=

# Optional: S3-Speicher für Bilder. Ohne S3_BUCKET, S3_ACCESS_KEY_ID und
# S3_SECRET_ACCESS_KEY ist das Hochladen aus, die Website läuft trotzdem.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Nur nötig, wenn dein Anbieter keine Pfad-Adressen kann (Standard mit S3_ENDPOINT: true)
S3_FORCE_PATH_STYLE=

# Optional: Website per Claude pflegen (/api/mcp). false schaltet es ab.
SITE_MCP=
