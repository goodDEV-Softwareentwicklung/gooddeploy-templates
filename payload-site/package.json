{
  "name": "gooddeploy-starter-payload-site",
  "version": "0.1.0",
  "private": true,
  "description": "Startvorlage: Website mit CMS (Next.js und Payload, Postgres) für gooddeploy",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "payload": "payload",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "generate:importmap": "payload generate:importmap",
    "generate:types": "payload generate:types",
    "test": "node --test tests/*.test.ts"
  },
  "engines": {
    "node": "^22.23.5 || ^24.22.3"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.94.0",
    "@payloadcms/next": "3.94.0",
    "@payloadcms/plugin-redirects": "3.94.0",
    "@payloadcms/plugin-seo": "3.94.0",
    "@payloadcms/richtext-lexical": "3.94.0",
    "@payloadcms/storage-s3": "3.94.0",
    "@payloadcms/translations": "3.94.0",
    "graphql": "16.15.0",
    "lucide-react": "1.71.0",
    "next": "16.4.6",
    "payload": "3.94.0",
    "pg": "8.20.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
}
